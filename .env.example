# ===== Safety =====
TESTNET=true
ALLOW_LIVE=false
DRY_RUN=true

# ===== Market / strategy =====
BINANCE_MARKET=futures_usdt
FUTURES_LEVERAGE=2
FUTURES_MARGIN_TYPE=ISOLATED
FUTURES_FORCE_ONE_WAY=true
FUTURES_SCAN_TOP_N=10
# Selected initial 10 liquid USDⓈ-M USDT perpetuals for Demo/Testnet; scanner still validates each against exchangeInfo.
FUTURES_APPROVED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,LTCUSDT
FUTURES_MAX_MARGIN_FRACTION=0.25
FUTURES_LIQUIDATION_BUFFER_PCT=0.01
# ===== Quant / research layer (shadow-only) =====
FEATURE_STORE_ENABLED=true
QUANT_RANKING_ENABLED=true
FEATURE_STORE_PATH=data/features.sqlite3
AI_SHADOW_ENABLED=true
SHADOW_EXECUTION_ENABLED=true
SHADOW_FEE_PCT=0.001
SHADOW_TICK_PCT=0.0001
DERIVATIVES_FEATURES_ENABLED=false
CPCV_GROUPS=6
CPCV_TEST_GROUPS=2
CPCV_PURGE_BARS=10
CPCV_EMBARGO_BARS=10
STRESS_CASES=100
STRESS_TICK_PCT=0.0001

SYMBOL=BTCUSDT
INTERVAL=1h
EXECUTION_TIMEFRAME=1h
HTF_INTERVAL=4h
STRUCTURAL_TIMEFRAMES=1d,4h,1h,15m
WILLIAMS_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,LTCUSDT
ALLOW_LONG=true
ALLOW_SHORT=true
REQUIRE_HTF_CONFIRMATION=true
CAMPAIGN_TRAIL_BARS=5
# Spot fixed TP/SL is not used by the canonical Futures campaign.
POSITION_FRACTION=0.25
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.0

# ===== Risk guardrails =====
RISK_PER_TRADE_PCT=0.0025
MAX_RISK_PER_TRADE_PCT=0.0025
MAX_DAILY_LOSS_PCT=0.01
MAX_TRADES_PER_DAY=5
MAX_CONSECUTIVE_LOSSES=2
COOLDOWN_MINUTES=30
MIN_RISK_REWARD=1.5
ATR_PERIOD=14
MAX_ATR_PCT=0.08
MAX_SPREAD_PCT=0.0015
MAX_WAVE_EXHAUSTION_FOR_ENTRY=80
# Wave hierarchy / scenario engine
WAVE_LOOKBACK=220
WAVE_MIN_BARS=140
WAVE_MICRO_ENABLED=false
WAVE_MICRO_MIN_BARS=40
# Market-data safety gates
MARKET_DATA_SNAPSHOT_DEPTH=20
MARKET_DATA_MAX_AGE_MS=2000
BALANCE_TOLERANCE_PCT=0.002
POLL_SECONDS=20

# ===== Mobile API =====
# Use a long random secret; never commit the real value.
MOBILE_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
MOBILE_API_HOST=127.0.0.1
MOBILE_API_PORT=8000

# Optional server-side credentials. Android can configure these at runtime.
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Williams parameters (classic Profitunity defaults + conservative filters) =====
# TC2 is the only execution-enabled book profile. NTD signal helpers exist for research,
# but NTD_FIVE_DIMENSIONS is blocked for new entries until Balance Line trades are source-verified.
WILLIAMS_SIGNAL_PROFILE=TC2_THREE_WISE_MEN
ALLIGATOR_JAW=13
ALLIGATOR_TEETH=8
ALLIGATOR_LIPS=5
JAW_SHIFT=8
TEETH_SHIFT=5
LIPS_SHIFT=3
AO_FAST=5
AO_SLOW=34
AC_PERIOD=5
MIN_ALLIGATOR_SPREAD_PCT=0.001
FRACTAL_LEFT=2
FRACTAL_RIGHT=2
SUPER_AO_BARS=3
MIN_WISE_MEN_CONFIRMATIONS=2
ALLOW_COUNTERTREND_WISE_MAN=false
DB_PATH=data/trader.sqlite3

# Futures portfolio safety: one active campaign; initial entry 0.20%, individual-entry cap 0.25%, campaign/portfolio cap 0.60%, daily-loss cap 1%.
MAX_OPEN_POSITIONS=1
MAX_TOTAL_RISK_PCT=0.006
MAX_RISK_PER_TRADE_PCT=0.0025
MIN_RISK_ALLOCATION_PCT=0.001

# Williams 4.18 production architecture
WILLIAMS_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,LTCUSDT
# Futures trading uses only the explicit ten-symbol allowlist above; no dynamic discovery or volume-based substitution.
AUTO_SCAN_SYMBOLS=
SCAN_ALL_USDT=false
SCAN_MAX_SYMBOLS=10
LIQUIDITY_PRESELECT=0
ALLOW_LONG=true
ALLOW_SHORT=true
NO_TRADE_WHEN_UNCERTAIN=true
MTF_CONTEXT_ENABLED=true
# Empty chain = select an appropriate hierarchy for the chosen base/execution timeframe.
# The Williams campaign decision timeframe is H1; D1/H4 provide context and M15 is execution monitoring.
WAVE_FULL_TF_ALL=false
WAVE_TF_CHAIN=
MAX_L2_SLIPPAGE_PCT=0.0015
# Binance Futures symbol filters/rules are re-read at execution time.
# Execution timeframe is the final lower-timeframe trigger inside the MTF wave hierarchy.
CAMPAIGN_TRAIL_BARS=5
CAMPAIGN_ALLOW_REVERSAL_ADD=false
WAVE_PROB_THRESHOLD=0.60
WAVE_MARGIN_THRESHOLD=0.15
WAVE_ENTROPY_THRESHOLD=0.80

# Worst-case risk reserve: two trading fees plus bounded execution slippage.
FEE_BUFFER_PER_SIDE_PCT=0.001
RISK_SLIPPAGE_BUFFER_PCT=0.0015

# Legacy TC1 Point-Zero overlay; disabled by default for the TC2 Three Wise Men profile.
REQUIRE_POINT_ZERO_FOR_WM1=false
